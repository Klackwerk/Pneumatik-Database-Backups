# Pneumatik 2.0 deployment configuration (for docker-compose.yml)

# --- database (the app's own datastore) --------------------------------------
DB_NAME=pneumatik
DB_USER=pneumatik
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- encryption ---------------------------------------------------------------
# Path to a file containing the base64-encoded 32-byte data-encryption key.
# Generate one with: openssl rand -base64 32 > pneumatik.key
PNEUMATIK_KEY_FILE=./pneumatik.key

# Legacy cipher parameters from the 1.x install — REQUIRED ONCE when upgrading
# an existing database so stored credentials can be re-encrypted at first
# startup (values of GRAILS_ENCRYPTION_SECRET / GRAILS_ENCRYPTION_SALT).
# Remove after the first successful start.
PNEUMATIK_LEGACY_SECRET=
PNEUMATIK_LEGACY_SALT=

# --- auth ---------------------------------------------------------------------
# Signs the API's JWTs — anyone who knows it can mint an admin token. Required
# in production: startup fails if it is unset or shorter than 32 characters.
# openssl rand -base64 48
PNEUMATIK_JWT_SECRET=change-me

# Password for the "admin" account created on the very first start. Leave empty
# and Pneumatik generates one and prints it to the container log once
# (docker compose logs pneumatik). Ignored once the account exists.
PNEUMATIK_ADMIN_PASSWORD=

# Failed sign-ins are counted per client address and per username; after
# MAX_ATTEMPTS within WINDOW_MINUTES that key is refused for LOCK_MINUTES.
PNEUMATIK_LOGIN_MAX_ATTEMPTS=5
PNEUMATIK_LOGIN_WINDOW_MINUTES=15
PNEUMATIK_LOGIN_LOCK_MINUTES=15
# Set to true ONLY behind a reverse proxy that overwrites X-Forwarded-For —
# otherwise callers choose their own throttling identity by sending the header.
# Also lets X-Forwarded-Proto decide whether HSTS is sent.
PNEUMATIK_TRUST_FORWARDED_FOR=false

# --- backups --------------------------------------------------------------------
# How long a single dump may run before it is killed.
PNEUMATIK_BACKUP_TIMEOUT_MINUTES=30
# Hours of silence after a failure mail before the same database mails again.
PNEUMATIK_NOTIFICATION_QUIET_HOURS=6
# Encrypt stored archives with AES-256-GCM, keyed from PNEUMATIK_KEY_FILE.
# WARNING: with this on, losing the keyfile means losing every backup — the
# dumps cannot be recovered without it. Read docs/restore.md first.
PNEUMATIK_ENCRYPT_ARCHIVES=false

# --- image ----------------------------------------------------------------------
# Which ghcr.io/klackwerk/pneumatik-database-backups tag to run. Defaults to the
# newest 3.2.x; pin an exact release (3.2.0) if you prefer to upgrade by hand.
PNEUMATIK_VERSION=3.2
# The image is built for linux/amd64. On an arm64 host (Apple Silicon, Graviton,
# Raspberry Pi) Docker runs it emulated; leave this as it is.
PNEUMATIK_PLATFORM=linux/amd64

# --- http ----------------------------------------------------------------------
PNEUMATIK_HTTP_PORT=8080
# Comma-separated extra origins allowed to call the API. The bundled frontend
# is same-origin and needs no entry here.
PNEUMATIK_CORS_ORIGINS=http://localhost

# --- storage --------------------------------------------------------------------
PNEUMATIK_STORAGE_DIR=./storage
PNEUMATIK_S3_REGION=us-east-1
PNEUMATIK_S3_ENDPOINT=
PNEUMATIK_S3_BUCKET=
PNEUMATIK_S3_KEY=
PNEUMATIK_S3_SECRET=
PNEUMATIK_S3_BASE_PATH=backups

# --- mail -----------------------------------------------------------------------
PNEUMATIK_MAIL_HOST=
PNEUMATIK_MAIL_PORT=587
PNEUMATIK_MAIL_USERNAME=
PNEUMATIK_MAIL_PASSWORD=
PNEUMATIK_MAIL_FROM=pneumatik@example.com
# Failed-backup notifications go here
PNEUMATIK_MAIL_ADMIN=admin@example.com
